{
  "name": "Streamlit Development Environment",
  "image": "python:3.12-slim",
  
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  
  "postCreateCommand": "pip install --disable-pip-version-check uv && uv sync --locked --all-groups",

  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit App",
      "onAutoForward": "openBrowser"
    }
  },
  
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "astral-sh.ruff",
        "joshrmosier.streamlit-runner"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "astral-sh.ruff",
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        },
        "files.autoSave": "afterDelay"
      }
    }
  },
  
  "remoteUser": "root"
}
